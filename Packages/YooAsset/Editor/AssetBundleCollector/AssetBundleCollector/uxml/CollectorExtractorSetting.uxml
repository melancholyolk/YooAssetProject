<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:GroupBox style="flex-direction: column; justify-content: flex-start; align-items: flex-start; background-color: rgb(46, 46, 46); margin-bottom: 3px; margin-top: 3px; padding-right: 6px; padding-left: 6px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; padding-top: 6px; padding-bottom: 6px;">
        <ui:DropdownField label="Extrator Type" name="extractorType" style="flex-direction: column; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
        <ui:TextField picking-mode="Ignore" label="Extrator Sub Folder" name="extractorPath" is-delayed="false" style="flex-direction: column; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 6px; padding-bottom: 5px;" />
        <ui:TextField picking-mode="Ignore" label="Asset Name Template" name="assetNameTemplate" is-delayed="false" tooltip="Support Mark:  {CollectorName}, {AssetName}, {FilePath}" style="flex-direction: column; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 6px; padding-bottom: 5px;" />
        <ui:TextField picking-mode="Ignore" label="{FilePath} Pick Regex" name="filePathPickRule" is-delayed="false" tooltip="{CollectorName}" style="flex-direction: column; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 6px; padding-bottom: 5px;" />
    </ui:GroupBox>
</ui:UXML>
